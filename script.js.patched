const PRESET_COLORS = [
    'transparent',
    '#f87171', '#fb923c', '#fbbf24', '#facc15', '#a3e635',
    '#4ade80', '#34d399', '#2dd4bf', '#22d3ee', '#38bdf8',
    '#60a5fa', '#4f46e5', '#a78bfa', '#c084fc', '#e879f9',
